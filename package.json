{
  "name": "games-meta-launcher",
  "version": "0.35.0",
  "main": "src/electron-main.mjs",
  "private": true,
  "type": "module",
  "description": "Lanzador local y catálogo de juegos para Windows.",
  "author": "Jorge Miguez",
  "gml": {
    "releases": "jmiguez78/games-meta-launcher"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "scan": "node src/indexer.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "format": "prettier --write src public test",
    "check": "node tools/check-syntax.mjs && node tools/check-modules.mjs && node tools/check-styles.mjs",
    "test:ui": "playwright test -c test/ui/playwright.config.mjs",
    "verify": "npm run check && npm test && npm run test:ui",
    "desktop": "electron .",
    "package": "node tools/package.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.63.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "prettier": "3.6.2"
  },
  "build": {
    "appId": "com.jorgemiguez.gamesmetalauncher",
    "productName": "Games Meta Launcher",
    "files": [
      "public/**/*",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data/library.sample.json",
        "to": "library.sample.json"
      }
    ],
    "asar": false,
    "win": {
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "dist"
    },
    "portable": {
      "splashImage": "build/splash.bmp"
    }
  },
  "dependencies": {
    "steam-games-mcp": "0.17.0"
  }
}
