{
  "name": "games-meta-launcher",
  "version": "0.18.0",
  "main": "src/electron-main.mjs",
  "private": true,
  "type": "module",
  "description": "Lanzador local y catálogo de juegos para Windows.",
  "author": "Jorge Miguez",
  "scripts": {
    "start": "node src/server.mjs",
    "scan": "node src/indexer.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "format": "prettier --write src public test",
    "check": "node --check src/server.mjs && node --check src/indexer.mjs && node --check src/steam.mjs && node --check public/shelves.js && node --check public/app.js && node --check public/steam-ui.js",
    "desktop": "electron .",
    "package": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "prettier": "3.6.2"
  },
  "build": {
    "appId": "com.jorgemiguez.gamesmetalauncher",
    "productName": "Games Meta Launcher",
    "files": [
      "public/**/*",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data/library.sample.json",
        "to": "library.sample.json"
      }
    ],
    "asar": false,
    "win": {
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "release-v0180"
    }
  },
  "dependencies": {
    "steam-games-mcp": "0.17.0"
  }
}
