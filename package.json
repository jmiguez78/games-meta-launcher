{
  "name": "games-meta-launcher",
  "version": "0.7.2",
  "main": "src/electron-main.mjs",
  "private": true,
  "type": "module",
  "description": "Lanzador local y catálogo de juegos para Windows.",
  "author": "Jorge Miguez",
  "scripts": {
    "start": "node src/server.mjs",
    "scan": "node src/indexer.mjs",
    "check": "node --check src/server.mjs && node --check src/indexer.mjs && node --check public/app.js",
    "desktop": "electron .",
    "package": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.jorgemiguez.gamesmetalauncher",
    "productName": "Games Meta Launcher",
    "files": ["public/**/*", "src/**/*", "package.json"],
    "extraResources": [{ "from": "data/library.sample.json", "to": "library.sample.json" }],
    "asar": false,
    "directories": { "output": "release-v072" }
  }
}
